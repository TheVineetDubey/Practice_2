package Array;

public class CharOccurrence {
    public static void main(String[] args) {

        // Input array with characters
        char[] array = {'a', 'b', 'c', 'a', 'b', 'a', 'c', 'd', 'e', 'f', 'a'};

        // Create a count array for characters (size 256 for ASCII range)
        int[] countArray = new int[256];  // Array to count occurrences of all ASCII characters

        // Loop through the input array to count occurrences
        for (int i = 0; i < array.length; i++) {
            char ch = array[i];
            countArray[ch]++;  // Use ASCII value of character as the index
        }

        // Display the count of each character that occurred
        for (int i = 0; i < countArray.length; i++) {
            if (countArray[i] > 0) {
                System.out.println((char) i + " occurs " + countArray[i] + " times");
            }
        }
    }
}
